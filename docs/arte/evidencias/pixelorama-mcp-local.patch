@@ -5,9 +5,28 @@
  * All drawing operations are sent as POST /command with a JSON body.
  */
 
+import { readFileSync } from "node:fs";
+
 const BRIDGE_URL = process.env.PIX_MCP_BRIDGE_URL || "http://127.0.0.1:7373";
 const DEFAULT_TIMEOUT_MS = parseInt(process.env.PIX_MCP_TIMEOUT_MS || "120000", 10) || 120_000;
 
+function authorizationHeaders(): Record<string, string> {
+  const tokenPath = process.env.PIX_MCP_TOKEN_FILE;
+  if (!tokenPath) {
+    throw new Error("PIX_MCP_TOKEN_FILE must point to the Pixelorama bridge token file.");
+  }
+  let token: string;
+  try {
+    token = readFileSync(tokenPath, "utf8").replace(/^\uFEFF/, "").trim();
+  } catch {
+    throw new Error("Cannot read the Pixelorama bridge token file.");
+  }
+  if (!token || /[^\x21-\x7E]/.test(token)) {
+    throw new Error("The Pixelorama bridge token file is empty or invalid.");
+  }
+  return { Authorization: `Bearer ${token}` };
+}
+
 export interface BridgeResponse {
   success: boolean;
   data?: Record<string, any>;
