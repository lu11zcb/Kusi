# Copiar como .env en la raíz. Completar los secretos solo en ese archivo local.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# 10.0.2.2 es como el emulador de Android llega a esta PC.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

# Base compartida: Django usa admin; Spring usa edu.
PG_DATABASE=kusi
PG_USER=postgres
PG_PASSWORD=
PG_HOST=127.0.0.1
PG_PORT=5432
DJANGO_SCHEMA=admin

# La misma clave interna para Django y Spring.
CLAVE_INTERNA=
EDU_API_URL=http://127.0.0.1:8080
DJANGO_INTERNAL_URL=http://127.0.0.1:8000

# IA (Groq): cada uno crea su clave en https://console.groq.com/keys y la pega aquí.
# Sin clave, las solicitudes de propuesta quedan guardadas como pendientes.
GROQ_API_KEY=
GROQ_MODELO=llama-3.3-70b-versatile
