# Copiar como .env en la raíz. Completar los secretos solo en ese archivo local.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Base compartida: Django usa admin; Spring usa edu.
PG_DATABASE=kusi
PG_USER=postgres
PG_PASSWORD=
PG_HOST=127.0.0.1
PG_PORT=5432
DJANGO_SCHEMA=admin

# La misma clave interna para Django y Spring.
CLAVE_INTERNA=
EDU_API_URL=http://127.0.0.1:8080
DJANGO_INTERNAL_URL=http://127.0.0.1:8000
