# Listo para copiar:  copy .env.example .env
# Luego pega tu GROQ_API_KEY en el .env (ese archivo no se sube).
# Si al instalar PostgreSQL pusiste otra contraseña que no sea "postgres", cámbiala en PG_PASSWORD.
# Las claves de abajo son solo para desarrollo local; en un servidor real se cambian.

DJANGO_SECRET_KEY=kusi-solo-desarrollo-local-T7qv2Lr9Xw4mPz8Kc3Nd6Hs1Jb5Ye0Ua
DJANGO_DEBUG=True
# 10.0.2.2 es como el emulador de Android llega a esta PC.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

# Base compartida: Django usa admin; Spring usa edu.
PG_DATABASE=kusi
PG_USER=postgres
PG_PASSWORD=postgres
PG_HOST=127.0.0.1
PG_PORT=5432
DJANGO_SCHEMA=admin

# La misma clave interna para Django y Spring (ambos leen este archivo).
CLAVE_INTERNA=kusi-clave-interna-solo-desarrollo-local-8fQ2wZ5rB9mX3kV7
EDU_API_URL=http://127.0.0.1:8080
DJANGO_INTERNAL_URL=http://127.0.0.1:8000

# IA (Groq): cada uno crea su clave gratis en https://console.groq.com/keys
# Sin clave, las solicitudes de propuesta quedan guardadas como pendientes.
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-120b
