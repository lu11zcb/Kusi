                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:311" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>

                <!-- Reposo: respira con la fila 3 durante ~6,5 s y luego saluda corto. -->
                <AnimationState x="420" y="0" animationId="0:402" reset="true" id="0:311">
                    <StateTransition stateToId="0:315">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean><DataBindContext sourcePathIds="0:500-0:511" propertyKey="634"/></BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:314">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
