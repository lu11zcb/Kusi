        <!--
            Máquina de estados. Cada capa anima cosas distintas, así nunca se pisan.
            Orden de la entrada (una sola vez, la primera pantalla que ve el niño):
              0 ms   Kusi sube y aparece (protagonista); el camino aparece sin moverse
              100 ms los bloques suben un poco
              170 ms el libro sube un poco
            Después solo quedan vaivenes lentos. Kusi saluda solo de vez en cuando (cada ~6,5 s).
        -->
        <StateMachine name="Kusi" id="0:300">

            <!-- Capa 1 · Cuadros de Kusi y destellos. Sin mezcla entre estados. -->
            <StateMachineLayer name="Cuadros" id="0:301">
                <AnyState x="900" y="-200"/>
                <ExitState x="1060" y="-200"/>
                <EntryState x="0" y="0"><StateTransition stateToId="0:310"/></EntryState>

                <!-- Saludo de entrada (mismo saludo que al tocarlo). -->
                <AnimationState x="180" y="0" animationId="0:401" reset="true" id="0:310">
                    <StateTransition stateToId="0:315">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean><DataBindContext sourcePathIds="0:500-0:511" propertyKey="634"/></BindablePropertyBoolean>
