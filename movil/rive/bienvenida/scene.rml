            </Shape>
        </Node>

        <!-- Kusi. El origen del nodo son sus pies: escalar desde aquí aplasta hacia el suelo.
             Los valores escritos son los del cuadro 0 de la entrada (abajo y transparente). -->
        <Node x="128" y="322" opacity="0" scaleX="0.94" scaleY="0.94" name="kusi" id="0:40">
            <Image x="-132" y="-501" originX="0" originY="0" assetId="0:10" name="hoja_kusi" id="0:41">
