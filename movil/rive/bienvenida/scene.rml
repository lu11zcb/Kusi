            </Shape>
            <Shape x="22.5" y="-13" rotation="1.05" name="destello_3">
                <Rectangle width="5" height="11" cornerRadiusTL="2.5" name="Trazo"/>
                <Fill name="Relleno"><SolidColor colorValue="FFF5B42E" name="Oro"/></Fill>
            </Shape>
        </Node>

        <!-- Pasto del frente: tapa un poco el borde del suelo. Se mece apenas desde la base. -->
        <Node x="334" y="306" rotation="-0.03" name="pasto_der" id="0:30">
