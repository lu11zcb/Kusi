                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>

            <!-- Capa 4 · Libro. Su vaivén dura distinto que el de los bloques para no ir a la par. -->
            <StateMachineLayer name="Libro" id="0:304">
                <AnyState x="900" y="-200"/>
                <ExitState x="1060" y="-200"/>
                <EntryState x="0" y="0"><StateTransition stateToId="0:340"/></EntryState>
                <AnimationState x="180" y="0" animationId="0:430" id="0:340">
                    <StateTransition stateToId="0:342">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
