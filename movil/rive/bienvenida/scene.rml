                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>

            <!-- Capa 2 · Cuerpo: entrada, vaivén al respirar y brinco al tocarlo. -->
            <StateMachineLayer name="Cuerpo" id="0:302">
                <AnyState x="900" y="-200"/>
                <ExitState x="1060" y="-200"/>
                <EntryState x="0" y="0"><StateTransition stateToId="0:320"/></EntryState>

