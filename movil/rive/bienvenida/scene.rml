                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>

                <!-- Quieto: sin respiración ni saludos solos. Tocar y hablar siguen respondiendo. -->
                <AnimationState x="180" y="220" animationId="0:405" id="0:315">
                    <StateTransition stateToId="0:313">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
