                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:311" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>

                <!-- Saludo al tocarlo: termina el saludo y, si la voz sigue sonando, habla. -->
                <AnimationState x="680" y="220" animationId="0:401" reset="true" id="0:313">
                    <StateTransition stateToId="0:314" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100">
                        <TransitionViewModelCondition opValue="equal">
