                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:312" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>

                <!-- Saludo corto que Kusi hace solo, para invitar a tocarlo. -->
                <AnimationState x="420" y="220" animationId="0:403" reset="true" id="0:312">
                    <StateTransition stateToId="0:314">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean><DataBindContext sourcePathIds="0:500-0:510" propertyKey="634"/></BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
