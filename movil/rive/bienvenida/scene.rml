                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>

                <!-- Brinco: la respuesta al toque empieza en el mismo cuadro del toque. -->
                <AnimationState x="420" y="220" animationId="0:412" reset="true" id="0:322">
                    <StateTransition stateToId="0:321" duration="120" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>

                <AnimationState x="180" y="220" animationId="0:413" id="0:323">
                    <StateTransition stateToId="0:321" duration="200">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean><DataBindContext sourcePathIds="0:500-0:511" propertyKey="634"/></BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>

            <!-- Capa 3 · Bloques 1-2-3. -->
            <StateMachineLayer name="Bloques" id="0:303">
                <AnyState x="900" y="-200"/>
                <ExitState x="1060" y="-200"/>
                <EntryState x="0" y="0"><StateTransition stateToId="0:330"/></EntryState>
                <AnimationState x="180" y="0" animationId="0:420" id="0:330">
                    <StateTransition stateToId="0:332">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean><DataBindContext sourcePathIds="0:500-0:511" propertyKey="634"/></BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:331" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
